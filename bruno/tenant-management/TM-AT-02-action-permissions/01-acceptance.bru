meta {
  name: TM-AT-02 Permission dan idempotensi perubahan status
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

script:pre-request {
  const password = bru.getProcessEnv("DAGANTARA_TM_TEST_PASSWORD");
  if (!password) throw new Error("Set DAGANTARA_TM_TEST_PASSWORD for the migration fixture");
  req.setBody({ username: "tm-admin", password });
}

tests {
  const axios = require("axios");
  const { scenario } = require("./tenant-management/scenario.js");

  test("TM-AT-02 Permission dan idempotensi perubahan status", async function () {
    await scenario({ axios, bru, expect, res }).authorizeActions();
  });
}
