meta {
  name: Fixture login owner-b
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/{{shopB}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {}
}

script:pre-request {
  const prefix = bru.getProcessEnv("INVENTORY02_FIXTURE_PREFIX");
  const password = bru.getProcessEnv("INVENTORY02_FIXTURE_PASSWORD");
  if (!prefix || !password) throw new Error("Load the Inventory 02 fixture and export its prefix and password");
  bru.setVar("shopA", prefix + "-a");
  bru.setVar("shopB", prefix + "-b");
  req.setBody({ username: "im02-owner", password });
}

tests {
  test("Fixture login owner-b", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.passwordChangeRequired).to.equal(false);
    expect(data.accessToken).to.be.a("string");
    bru.setVar("ownerB", data.accessToken);
  });
}
