meta {
  name: IM-AT-08 Saldo varian menjadi nol setelah koreksi
  type: http
  seq: 34
}

get {
  url: {{baseUrl}}/{{shopA}}/api/v1/inventory/products/{{defaultProduct}}/stock
  body: none
  auth: bearer
}

auth:bearer {
  token: {{reader}}
}

tests {
  test("IM-AT-08 Saldo varian menjadi nol setelah koreksi", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.productId).to.equal(bru.getVar("defaultProduct"));
    expect(data.totalQuantity).to.equal(0);
    expect(data.variants).to.have.length(1);
    expect(data.variants[0]).to.include({ sku: "DEFAULT", quantity: 0 });
    expect(data.variants[0].optionValues).to.deep.equal([]);
    expect(data.optionTotals).to.deep.equal([]);
  });
}
