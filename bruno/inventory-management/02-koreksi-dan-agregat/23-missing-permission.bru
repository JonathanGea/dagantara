meta {
  name: IM-AT-05 Pembaca tanpa izin koreksi mendapat 403
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/{{shopA}}/api/v1/inventory/receipts/{{receipt}}/corrections
  body: json
  auth: bearer
}

auth:bearer {
  token: {{reader}}
}

headers {
  Idempotency-Key: missing-permission
}

body:json {
  {
    "reason": "Hitung lagi",
    "lines": [
      {
        "receiptLineId": "{{line-H-M}}",
        "quantity": 6
      }
    ]
  }
}

tests {
  test("IM-AT-05 Pembaca tanpa izin koreksi mendapat 403", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().errorCode).to.equal("FORBIDDEN");
  });
}
