meta {
  name: IM-AT-06 Produk tanpa opsi memiliki rincian kosong
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/{{shopA}}/api/v1/inventory/products/{{defaultProduct}}/stock
  body: none
  auth: bearer
}

auth:bearer {
  token: {{reader}}
}

tests {
  test("IM-AT-06 Produk tanpa opsi memiliki rincian kosong", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.productId).to.equal(bru.getVar("defaultProduct"));
    expect(data.totalQuantity).to.equal(3);
    expect(data.variants).to.have.length(1);
    expect(data.variants[0]).to.include({ sku: "DEFAULT", quantity: 3 });
    expect(data.variants[0].optionValues).to.deep.equal([]);
    expect(data.optionTotals).to.deep.equal([]);
  });
}
