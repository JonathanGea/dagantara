meta {
  name: Fixture produk tanpa opsi
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/{{shopA}}/api/v1/catalog/products
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerA}}
}

tests {
  test("Fixture produk tanpa opsi", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data).to.have.length(1);
    expect(data[0].name).to.equal("Kaos tanpa opsi");
    expect(data[0].id).to.be.a("string");
    expect(data[0].primaryCategoryId).to.be.a("string");
    bru.setVar("defaultProduct", data[0].id);
    bru.setVar("category", data[0].primaryCategoryId);
  });
}
