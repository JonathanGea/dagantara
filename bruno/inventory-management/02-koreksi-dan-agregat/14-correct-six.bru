meta {
  name: IM-AT-04 Koreksi 8 menjadi 6
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/{{shopA}}/api/v1/inventory/receipts/{{receipt}}/corrections
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerA}}
}

headers {
  Idempotency-Key: recount-six
}

body:json {
  {
    "reason": "Jumlah terhitung enam",
    "lines": [
      {
        "receiptLineId": "{{line-H-M}}",
        "quantity": 6
      }
    ]
  }
}

tests {
  test("IM-AT-04 Koreksi 8 menjadi 6", function () {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody().data;
    expect(data.id).to.match(/^[0-9a-f-]{36}$/);
    expect(data.receiptId).to.equal(bru.getVar("receipt"));
    expect(data.correctedBy).to.equal(bru.getVar("ownerAId"));
    expect(data.reason).to.equal("Jumlah terhitung enam");
    expect(Number.isNaN(Date.parse(data.createdAt))).to.equal(false);
    expect(data.lines).to.deep.equal([{
      receiptLineId: bru.getVar("line-H-M"), previousQuantity: 8, quantity: 6, delta: -2
    }]);
    bru.setVar("firstCorrection", data);
  });
}
