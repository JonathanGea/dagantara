meta {
  name: IM-AT-02 Jumlah pecahan membatalkan semua baris
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/{{shopA}}/api/v1/inventory/receipts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminA}}
}

headers {
  Idempotency-Key: receipt-a
}

body:json {
  {
    "lines": [
      {
        "sku": "DEFAULT-A",
        "quantity": 3
      },
      {
        "sku": "PUTIH.L_01",
        "quantity": 1.5
      }
    ]
  }
}

tests {
  test("IM-AT-02 Jumlah pecahan membatalkan semua baris", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("content-type")).to.include("application/problem+json");
    expect(res.getBody().status).to.equal(400);
    expect(res.getBody().errorCode).to.equal("INVALID_QUANTITY");
  });
}
