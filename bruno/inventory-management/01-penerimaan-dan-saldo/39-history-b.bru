meta {
  name: IM-AT-07 Riwayat B hanya memuat penerimaan B
  type: http
  seq: 39
}

get {
  url: {{baseUrl}}/{{shopB}}/api/v1/inventory/receipts?page=0&size=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminB}}
}

tests {
  test("IM-AT-07 Riwayat B hanya memuat penerimaan B", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.meta.page).to.equal(0);
    expect(body.meta.size).to.equal(1);
    expect(body.meta.totalElements).to.equal(1);
    expect(body.data.map(entry => entry.id)).to.deep.equal([bru.getVar("receiptB")]);
    expect(body.data[0].warehouseId).to.equal(bru.getVar("receiptBWarehouse"));
  });
}
