meta {
  name: Fixture admin A masuk ke URL tenant
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/{{shopA}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{ownerA}}",
    "password": "{{newPassword}}"
  }
}

tests {
  test("Fixture admin A masuk ke URL tenant", function () {
    expect(res.getStatus()).to.equal(200);
    const result = res.getBody().data;
    expect(result.passwordChangeRequired).to.equal(false);
    expect(result.accessToken).to.be.a("string");
    bru.setVar("adminA", result.accessToken);
  });
}
