meta {
  name: Fixture Role tenant dapat menerima catalog.read
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/{{shopA}}/api/v1/tenant/roles/{{readerRole}}/permissions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminA}}
}

body:json {
  {
    "permissions": [
      "catalog.read"
    ]
  }
}

tests {
  test("Fixture Role tenant dapat menerima catalog.read", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.permissions).to.deep.equal(["catalog.read"]);
  });
}
