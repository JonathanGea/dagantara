meta {
  name: IM-AT-03 Payload berbeda dengan key yang sama ditolak
  type: http
  seq: 35
}

post {
  url: {{baseUrl}}/{{shopA}}/api/v1/inventory/receipts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminA}}
}

headers {
  Idempotency-Key: receipt-a
}

body:json {
  {
    "lines": [
      {
        "sku": "FIX.HTP-M",
        "quantity": 9
      }
    ]
  }
}

tests {
  test("IM-AT-03 Payload berbeda dengan key yang sama ditolak", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("content-type")).to.include("application/problem+json");
    expect(res.getBody().status).to.equal(409);
    expect(res.getBody().errorCode).to.equal("IDEMPOTENCY_CONFLICT");
  });
}
