meta {
  name: IM-AT-01 Dua SKU produk Draft dibaca dengan saldo nol
  type: http
  seq: 24
}

get {
  url: {{baseUrl}}/{{shopA}}/api/v1/inventory/products/{{productA}}/stock
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminA}}
}

tests {
  test("IM-AT-01 Dua SKU produk Draft dibaca dengan saldo nol", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.productId).to.equal(bru.getVar("productA"));
    expect(data.variants).to.have.length(2);
    const bySku = Object.fromEntries(data.variants.map(variant => [variant.sku, variant]));
    const black = bySku["FIX.HTP-M"];
    const white = bySku["PUTIH.L_01"];
    expect(black.variantId).to.equal(bru.getVar("autoVariant"));
    expect(white.variantId).to.equal(bru.getVar("manualVariant"));
    expect(black.optionValues.map(option => option.valueId)).to.deep.equal([bru.getVar("black"), bru.getVar("medium")]);
    expect(white.optionValues.map(option => option.label)).to.deep.equal(["Putih", "L"]);
    expect(black.optionValues.map(option => option.label)).to.deep.equal(["Hitam", "M"]);
    expect(black.quantity).to.equal(0);
    expect(white.quantity).to.equal(0);
  });
}
