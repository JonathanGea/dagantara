meta {
  name: SS-AT-06 Identitas dan produk terbit mengikuti hostname langsung dan prefiks toko
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/ss01-b/api/v1/auth/login
  body: json
  auth: none
}

script:pre-request {
  const password = bru.getProcessEnv("SS01_FIXTURE_PASSWORD");
  if (!password) throw new Error("Set SS01_FIXTURE_PASSWORD");
  req.setBody({ username: "ss01-owner", password });
}

tests {
  const { fixture } = require("./store-settings/store-settings-fixture.js");

  test("Identitas dan produk terbit mengikuti hostname langsung dan prefiks toko", async function () {
    const f = await fixture(bru, expect, res);
    const first = { displayName: "Kopi Pagi", publicWhatsapp: "+6281234567890", publicEmail: "kopi@example.test" };
    const other = { displayName: "Teh Sore", publicWhatsapp: "+6281234567891", publicEmail: "teh@example.test" };
    let productA;
    let productB;
    try {
      productA = await f.publish(f.a, f.ownerA, "Kopi Bubuk SS06");
      productB = await f.publish(f.b, f.ownerB, "Teh Seduh SS06");
      f.checkSettings(f.a, await f.save(f.a, f.ownerA, first), first);
      f.checkSettings(f.b, await f.save(f.b, f.ownerB, other), other);
      await f.pages(f.a, first, productA);
      await f.pages(f.b, other, productB);

      const updated = { ...first, displayName: "Kopi Pagi Baru", publicEmail: "baru@example.test" };
      f.checkSettings(f.a, await f.save(f.a, f.ownerA, updated), updated);
      await f.pages(f.a, updated, productA);
      await f.pages(f.b, other, productB);
      f.checkSettings(f.b, await f.read(f.b, f.ownerB), other);
      for (const [store, own, foreign] of [[f.a, productA, productB], [f.b, productB, productA]]) {
        const list = (await f.request(store, "GET", f.publicProducts)).data;
        expect(list.map(item => item.id)).to.deep.equal([own.id]);
        await f.request(store, "GET", "/products/" + foreign.id, { status: 404, error: "NOT_FOUND" });
      }
    } finally {
      await f.save(f.a, f.ownerA, f.blank);
      await f.save(f.b, f.ownerB, f.blank);
      await f.publication(f.a, f.ownerA, productA, "DRAFT");
      await f.publication(f.b, f.ownerB, productB, "DRAFT");
    }
  });
}
