meta {
  name: SS-AT-04 Tolak kontak tidak valid dan pertahankan seluruh nilai sebelumnya
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/ss01-b/api/v1/auth/login
  body: json
  auth: none
}

script:pre-request {
  const password = bru.getProcessEnv("SS01_FIXTURE_PASSWORD");
  if (!password) throw new Error("Set SS01_FIXTURE_PASSWORD");
  req.setBody({ username: "ss01-owner", password });
}

tests {
  const { fixture } = require("./store-settings/store-settings-fixture.js");

  test("Tolak kontak tidak valid dan pertahankan seluruh nilai sebelumnya", async function () {
    const f = await fixture(bru, expect, res);
    const product = await f.publish(f.a, f.ownerA, "Kopi Kemasan SS04");
    const before = { displayName: "Kopi Pagi", publicWhatsapp: "+6281234567890", publicEmail: "kopi@example.test" };
    try {
      f.checkSettings(f.a, await f.save(f.a, f.ownerA, before), before);
      for (const [field, value] of [
        ["publicWhatsapp", "081234567890"], ["publicEmail", "first@example.test,second@example.test"]
      ]) {
        const problem = await f.save(f.a, f.ownerA, { ...before, displayName: "Gagal disimpan", [field]: value },
          { status: 400, error: "VALIDATION_ERROR" });
        expect(problem.violations.map(violation => violation.field)).to.include(field);
        f.checkSettings(f.a, await f.read(f.a, f.ownerA), before);
        await f.pages(f.a, before, product);
      }
    } finally {
      await f.save(f.a, f.ownerA, f.blank);
      await f.publication(f.a, f.ownerA, product, "DRAFT");
    }
  });
}
