meta {
  name: SS-AT-01 Nama provisioning untuk tenant lama dan katalog kosong maupun terbit
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/ss01-b/api/v1/auth/login
  body: json
  auth: none
}

script:pre-request {
  const password = bru.getProcessEnv("SS01_FIXTURE_PASSWORD");
  if (!password) throw new Error("Set SS01_FIXTURE_PASSWORD");
  req.setBody({ username: "ss01-owner", password });
}

tests {
  const { fixture } = require("./store-settings/store-settings-fixture.js");

  test("Nama provisioning untuk tenant lama dan katalog kosong maupun terbit", async function () {
    const f = await fixture(bru, expect, res);
    const before = await f.read(f.a, f.ownerA);
    f.checkSettings(f.a, before, f.blank);
    expect(await f.page(f.a, f.blank)).to.deep.equal([]);
    const adminPage = await f.request(f.a, "GET", "/admin/store-settings");
    expect(adminPage).to.include('id="settings" novalidate hidden');

    const product = await f.publish(f.a, f.ownerA, "Kopi Bubuk SS01");
    try {
      await f.pages(f.a, f.blank, product);
    } finally {
      await f.publication(f.a, f.ownerA, product, "DRAFT");
    }
  });
}
