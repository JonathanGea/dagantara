meta {
  name: UM-AT-13 URL pengajuan tertutup belum menerima login
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Host: closed-{{suffix}}.example.test
}

body:json {
  {
    "username": "{{owner}}",
    "password": "closed-{{suffix}}"
  }
}

tests {
  test("URL pengajuan tertutup belum menerima login", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().errorCode).to.equal("INVALID_CREDENTIALS");
  });
}
