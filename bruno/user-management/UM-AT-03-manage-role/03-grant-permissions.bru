meta {
  name: UM-AT-03 grants two held permissions
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/roles/{{managedRoleId}}/permissions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "permissionCodes": [
      "users.create",
      "users.read"
    ]
  }
}

tests {
  test("UM-AT-03 grants two held permissions", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.permissionCodes).to.have.members(["users.create", "users.read"]);
  });
}
