meta {
  name: UM-AT-07 Login operator tanpa izin provisioning
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {}
}

script:pre-request {
  const username = bru.getProcessEnv("DAGANTARA_TEST_LIMITED_USERNAME");
  const password = bru.getProcessEnv("DAGANTARA_TEST_LIMITED_PASSWORD");
  if (!username || !password) {
    throw new Error("Configure platform login fixture variables");
  }

  req.setBody({ username, password });
}

tests {
  test("Login operator tanpa izin provisioning", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.accessToken).to.be.a("string");
    bru.setVar("limited", res.getBody().data.accessToken);
  });
}
