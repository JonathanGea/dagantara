meta {
  name: UM-AT-07 Pengajuan selesai tetap menunjuk tenant yang sama
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/tenant-applications/{{applicationId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operator}}
}

tests {
  test("Pengajuan selesai tetap menunjuk tenant yang sama", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.status).to.equal("PROVISIONED");
    expect(data.tenantId).to.equal(bru.getVar("approvedTenantId"));
    expect(data).not.to.have.property("temporaryPassword");
  });
}
