meta {
  name: UM-AT-05 rejects a role with incompatible scope
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "username": "wrong-scope-account",
    "email": "wrong-scope-account@example.test",
    "fullName": "User Management Fixture",
    "password": "{{testPassword}}",
    "roleId": "00000000-0000-0000-0000-000000000103"
  }
}

tests {
  test("UM-AT-05 rejects a role with incompatible scope", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().errorCode).to.equal("INVALID_ROLE");
  });
}
