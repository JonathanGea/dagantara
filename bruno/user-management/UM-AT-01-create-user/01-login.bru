meta {
  name: Login as creator
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "creator",
    "tenantCode": "tenant-a",
    "password": "{{testPassword}}"
  }
}

script:pre-request {
  const password = bru.getProcessEnv("UM_TEST_PASSWORD");
  if (!password) {
    throw new Error("Set UM_TEST_PASSWORD to the fixture password");
  }
  bru.setVar("testPassword", password);
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("accessToken", res.getBody().data.accessToken);
  }
}

tests {
  test("Fixture account authenticates", function () {
    expect(res.getStatus()).to.equal(200);
    expect(Boolean(bru.getVar("accessToken"))).to.equal(true);
  });
}
