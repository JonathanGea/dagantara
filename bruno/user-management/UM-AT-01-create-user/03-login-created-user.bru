meta {
  name: Login as created-account
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "created-account",
    "tenantCode": "tenant-a",
    "password": "{{testPassword}}"
  }
}

script:pre-request {
  const password = bru.getProcessEnv("UM_TEST_PASSWORD");
  if (!password) {
    throw new Error("Set UM_TEST_PASSWORD to the fixture password");
  }
  bru.setVar("testPassword", password);
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("createdUserToken", res.getBody().data.accessToken);
  }
}

tests {
  test("Fixture account authenticates", function () {
    expect(res.getStatus()).to.equal(200);
    expect(Boolean(bru.getVar("createdUserToken"))).to.equal(true);
  });
}
