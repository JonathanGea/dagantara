meta {
  name: UM-AT-01 uses the authenticated tenant and selected role
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "username": "created-account",
    "email": "created-account@example.test",
    "fullName": "User Management Fixture",
    "password": "{{testPassword}}",
    "roleId": "00000000-0000-0000-0000-000000000102",
    "tenantId": "00000000-0000-0000-0000-000000000002"
  }
}

tests {
  test("UM-AT-01 uses the authenticated tenant and selected role", function () {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody().data;
    expect(data.id).to.be.a("string");
    expect(data.tenantId).to.equal("00000000-0000-0000-0000-000000000001");
    expect(data.roleId).to.equal("00000000-0000-0000-0000-000000000102");
    expect(data.username).to.equal("created-account");
    expect(data).to.have.all.keys("id", "tenantId", "roleId", "username");
  });
}
