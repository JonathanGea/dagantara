meta {
  name: UM-AT-09 UM-AT-01 Password baru membuka sesi biasa
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/shop-a-{{suffix}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{owner}}",
    "password": "{{newPassword}}"
  }
}

tests {
  test("UM-AT-01 Password baru membuka sesi biasa", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.passwordChangeRequired).to.equal(false);
    expect(data.accessToken).to.be.a("string");
    bru.setVar("aCurrentToken", data.accessToken);
  });
}
