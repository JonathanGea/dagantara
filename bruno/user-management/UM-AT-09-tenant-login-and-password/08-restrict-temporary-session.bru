meta {
  name: UM-AT-09 UM-AT-01 Sesi sementara hanya membuka alur ganti password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/shop-a-{{suffix}}/api/v1/auth/login
  body: json
  auth: bearer
}

auth:bearer {
  token: {{aToken}}
}

body:json {
  {
    "username": "{{owner}}",
    "password": "{{aTemporary}}"
  }
}

tests {
  test("UM-AT-01 Sesi sementara hanya membuka alur ganti password", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().errorCode).to.equal("PASSWORD_CHANGE_REQUIRED");
  });
}
