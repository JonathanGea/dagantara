meta {
  name: UM-AT-09 Onboarding langsung tenant B
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/tenants
  body: json
  auth: bearer
}

auth:bearer {
  token: {{operator}}
}

body:json {
  {
    "ownerUsername": "{{owner}}",
    "loginUrl": "https://{{platformHost}}/shop-b-{{suffix}}",
    "loginUrlReady": true,
    "storeName": "umb-path-b-{{suffix}}",
    "phoneNumber": "+628000000000"
  }
}

tests {
  test("Onboarding langsung tenant B", function () {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody().data;
    expect(data.ownerUsername).to.equal(bru.getVar("owner"));
    expect(data.loginUrl).to.equal("https://" + bru.getVar("platformHost") + "/shop-b-" + bru.getVar("suffix"));
    expect(data.tenantId).to.match(/^[0-9a-f-]{36}$/);
    expect(data.ownerId).to.match(/^[0-9a-f-]{36}$/);
    expect(data.temporaryPassword).to.match(/^[A-Za-z0-9_-]{32}$/);
    bru.setVar("bTenantId", data.tenantId);
    bru.setVar("bTemporary", data.temporaryPassword);
    expect(data.tenantId).not.to.equal(bru.getVar("aTenantId"));
  });
}
