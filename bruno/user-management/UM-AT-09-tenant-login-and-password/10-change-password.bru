meta {
  name: UM-AT-09 UM-AT-01 Pemilik mengganti password sementara dalam konteks tenant
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/shop-a-{{suffix}}/api/v1/auth/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{aToken}}
}

body:json {
  {
    "newPassword": "{{newPassword}}"
  }
}

script:pre-request {
  bru.setVar("newPassword", "new-" + bru.getVar("suffix") + "-" + Math.random().toString(36).slice(2));
}

tests {
  test("UM-AT-01 Pemilik mengganti password sementara dalam konteks tenant", function () {
    expect(res.getStatus()).to.equal(204);
  });
}
