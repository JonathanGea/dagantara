meta {
  name: UM-AT-09 Username yang sama bisa dipakai pada tenant B
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/shop-b-{{suffix}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{owner}}",
    "password": "{{bTemporary}}"
  }
}

tests {
  test("Username yang sama bisa dipakai pada tenant B", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.passwordChangeRequired).to.equal(true);
    expect(data.accessToken).to.be.a("string");
    bru.setVar("bToken", data.accessToken);
  });
}
