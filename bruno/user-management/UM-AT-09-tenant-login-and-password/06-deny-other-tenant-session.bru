meta {
  name: UM-AT-09 Sesi tenant A tidak bisa mengubah password melalui jalur B
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/shop-b-{{suffix}}/api/v1/auth/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{aToken}}
}

body:json {
  {
    "newPassword": "different-{{suffix}}-password"
  }
}

tests {
  test("Sesi tenant A tidak bisa mengubah password melalui jalur B", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().errorCode).to.equal("FORBIDDEN");
  });
}
