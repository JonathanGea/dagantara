meta {
  name: UM-AT-09 UM-AT-01 Password baru harus berbeda dari password sementara
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/shop-a-{{suffix}}/api/v1/auth/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{aToken}}
}

body:json {
  {
    "newPassword": "{{aTemporary}}"
  }
}

tests {
  test("UM-AT-01 Password baru harus berbeda dari password sementara", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().errorCode).to.equal("INVALID_NEW_PASSWORD");
  });
}
