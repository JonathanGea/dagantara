meta {
  name: UM-AT-09 UM-AT-01 Sesi sementara dicabut setelah password diganti
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/shop-a-{{suffix}}/api/v1/auth/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{aToken}}
}

body:json {
  {
    "newPassword": "unused-{{suffix}}-password"
  }
}

tests {
  test("UM-AT-01 Sesi sementara dicabut setelah password diganti", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().errorCode).to.equal("UNAUTHORIZED");
  });
}
