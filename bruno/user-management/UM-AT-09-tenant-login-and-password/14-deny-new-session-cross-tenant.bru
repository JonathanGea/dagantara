meta {
  name: UM-AT-09 Sesi biasa tenant A juga ditolak pada jalur B
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/shop-b-{{suffix}}/api/v1/auth/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{aCurrentToken}}
}

body:json {
  {
    "newPassword": "unused-{{suffix}}-password"
  }
}

tests {
  test("Sesi biasa tenant A juga ditolak pada jalur B", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().errorCode).to.equal("FORBIDDEN");
  });
}
