meta {
  name: UM-AT-09 UM-AT-01 Password sementara kehilangan akses setelah diganti
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/shop-a-{{suffix}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{owner}}",
    "password": "{{aTemporary}}"
  }
}

tests {
  test("UM-AT-01 Password sementara kehilangan akses setelah diganti", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().errorCode).to.equal("INVALID_CREDENTIALS");
  });
}
