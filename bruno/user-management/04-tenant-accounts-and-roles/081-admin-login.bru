meta {
  name: UM-AT-12 Admin tambahan masuk dengan izin yang sama
  type: http
  seq: 81
}

post {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{adminUsername}}",
    "password": "{{adminPassword}}"
  }
}

tests {
  test("UM-AT-12 Admin tambahan masuk dengan izin yang sama", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.passwordChangeRequired).to.equal(false);
    expect(data.accessToken).to.be.a("string");
    bru.setVar("adminToken", data.accessToken);
  });
}
