meta {
  name: UM-AT-12 Pengangkatan staf sebagai admin memerlukan nomor pemulihan
  type: http
  seq: 85
}

put {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users/{{assistantId}}/role
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerAToken}}
}

body:json {
  {
    "roleId": "{{adminARole}}"
  }
}

tests {
  test("UM-AT-12 Pengangkatan staf sebagai admin memerlukan nomor pemulihan", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().errorCode).to.equal("PHONE_NUMBER_REQUIRED");
  });
}
