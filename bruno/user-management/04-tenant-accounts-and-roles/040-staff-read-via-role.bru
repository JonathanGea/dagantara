meta {
  name: UM-AT-03 Staf membaca daftar sesuai izin role
  type: http
  seq: 40
}

get {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

tests {
  test("UM-AT-03 Staf membaca daftar sesuai izin role", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(res.getBody().meta.totalElements).to.equal(2);
    expect(data.every(item => item.tenantId === bru.getVar("tenantAId"))).to.equal(true);
  });
}
