meta {
  name: UM-AT-03 Ganti permission role
  type: http
  seq: 57
}

put {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/roles/{{delegateRole}}/permissions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerAToken}}
}

body:json {
  {
    "permissions": [
      "users.create",
      "users.read",
      "users.role.assign",
      "roles.permissions.update",
      "users.password.reset"
    ]
  }
}

tests {
  test("UM-AT-03 Ganti permission role", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.id).to.equal(bru.getVar("delegateRole"));
    expect(data.permissions).to.have.members(["users.create","users.read","users.role.assign","roles.permissions.update","users.password.reset"]);
  });
}
