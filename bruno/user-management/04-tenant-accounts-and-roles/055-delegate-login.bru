meta {
  name: UM-AT-03 Login calon pengelola
  type: http
  seq: 55
}

post {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{delegateUsername}}",
    "password": "{{delegatePassword}}"
  }
}

tests {
  test("UM-AT-03 Login calon pengelola", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.passwordChangeRequired).to.equal(false);
    expect(data.accessToken).to.be.a("string");
    bru.setVar("delegateToken", data.accessToken);
  });
}
