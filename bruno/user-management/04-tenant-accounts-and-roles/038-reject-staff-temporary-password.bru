meta {
  name: UM-AT-01 Password sementara lama langsung ditolak
  type: http
  seq: 38
}

post {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{staffUsername}}",
    "password": "{{staffTemporary}}"
  }
}

tests {
  test("UM-AT-01 Password sementara lama langsung ditolak", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().errorCode).to.equal("INVALID_CREDENTIALS");
  });
}
