meta {
  name: UM-AT-12 Admin tambahan masuk dengan password sementara
  type: http
  seq: 79
}

post {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{adminUsername}}",
    "password": "{{adminTemporary}}"
  }
}

tests {
  test("UM-AT-12 Admin tambahan masuk dengan password sementara", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.passwordChangeRequired).to.equal(true);
    expect(data.accessToken).to.be.a("string");
    bru.setVar("adminSetup", data.accessToken);
  });
}
