meta {
  name: UM-AT-11 Aktifkan kembali akun staf
  type: http
  seq: 110
}

post {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users/{{staffId}}/activate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAToken}}
}

tests {
  test("UM-AT-11 Aktifkan kembali akun staf", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.id).to.equal(bru.getVar("staffId"));
    expect(data.status).to.equal("ACTIVE");
    expect(data.roleId).to.equal(bru.getVar("readerRole"));
  });
}
