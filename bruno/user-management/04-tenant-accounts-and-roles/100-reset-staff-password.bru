meta {
  name: UM-AT-11 Reset staf mengeluarkan password sementara
  type: http
  seq: 100
}

post {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users/{{staffId}}/reset-password
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAToken}}
}

tests {
  test("UM-AT-11 Reset staf mengeluarkan password sementara", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(res.getHeader("cache-control")).to.include("no-store");
    expect(data.temporaryPassword).to.match(/^[A-Za-z0-9_-]{32}$/);
    bru.setVar("staffResetTemporary", data.temporaryPassword);
  });
}
