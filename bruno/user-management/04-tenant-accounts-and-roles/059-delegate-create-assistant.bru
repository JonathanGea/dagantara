meta {
  name: UM-AT-01 UM-AT-03 Pengelola berizin membuat staf
  type: http
  seq: 59
}

post {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{delegateToken}}
}

body:json {
  {
    "username": "{{assistantUsername}}",
    "roleId": "{{emptyRole}}",
    "tenantId": "{{tenantBId}}"
  }
}

tests {
  test("UM-AT-01 UM-AT-03 Pengelola berizin membuat staf", function () {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody().data;
    expect(res.getHeader("cache-control")).to.include("no-store");
    expect(data.account.id).to.match(/^[0-9a-f-]{36}$/);
    expect(data.account.tenantId).to.equal(bru.getVar("tenantAId"));
    expect(data.account.username).to.equal(bru.getVar("assistantUsername"));
    expect(data.account.roleId).to.equal(bru.getVar("emptyRole"));
    expect(data.account.status).to.equal("ACTIVE");
    expect(data.account.owner).to.equal(false);
    expect(data.temporaryPassword).to.match(/^[A-Za-z0-9_-]{32}$/);
    bru.setVar("assistantId", data.account.id);
    bru.setVar("assistantTemporary", data.temporaryPassword);
  });
}
