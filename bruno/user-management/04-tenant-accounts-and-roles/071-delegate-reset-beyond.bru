meta {
  name: UM-AT-08 Pengelola tidak dapat mengambil alih akun berizin lebih tinggi lewat reset
  type: http
  seq: 71
}

post {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users/{{upperId}}/reset-password
  body: none
  auth: bearer
}

auth:bearer {
  token: {{delegateToken}}
}

tests {
  test("UM-AT-08 Pengelola tidak dapat mengambil alih akun berizin lebih tinggi lewat reset", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().errorCode).to.equal("FORBIDDEN");
  });
}
