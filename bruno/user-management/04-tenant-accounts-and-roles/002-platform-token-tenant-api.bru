meta {
  name: UM-AT-04 Token platform tidak memberi akses pengelolaan tenant
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/tenant/users
  body: none
  auth: bearer
}

auth:bearer {
  token: {{platformToken}}
}

tests {
  test("UM-AT-04 Token platform tidak memberi akses pengelolaan tenant", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().errorCode).to.equal("FORBIDDEN");
  });
}
