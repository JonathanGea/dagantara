meta {
  name: UM-AT-11 Reset menolak password sebelumnya
  type: http
  seq: 102
}

post {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{staffUsername}}",
    "password": "{{staffPassword}}"
  }
}

tests {
  test("UM-AT-11 Reset menolak password sebelumnya", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().errorCode).to.equal("INVALID_CREDENTIALS");
  });
}
