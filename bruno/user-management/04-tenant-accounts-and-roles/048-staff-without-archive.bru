  token: {{staffToken}}
}

tests {
  test("UM-AT-11 Siklus akun memerlukan izin tindakan archive", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().errorCode).to.equal("FORBIDDEN");
  });
}
