meta {
  name: UM-AT-04 Login pemilik B
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Host: {{hostB}}
}

body:json {
  {
    "username": "{{ownerBUsername}}",
    "password": "{{ownerBPassword}}"
  }
}

tests {
  test("UM-AT-04 Login pemilik B", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.passwordChangeRequired).to.equal(false);
    expect(data.accessToken).to.be.a("string");
    bru.setVar("ownerBToken", data.accessToken);
  });
}
