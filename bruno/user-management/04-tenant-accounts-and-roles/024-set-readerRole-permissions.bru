meta {
  name: UM-AT-03 Ganti permission role
  type: http
  seq: 24
}

put {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/roles/{{readerRole}}/permissions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerAToken}}
}

body:json {
  {
    "permissions": [
      "users.read"
    ]
  }
}

tests {
  test("UM-AT-03 Ganti permission role", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.id).to.equal(bru.getVar("readerRole"));
    expect(data.permissions).to.have.members(["users.read"]);
  });
}
