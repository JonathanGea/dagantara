meta {
  name: UM-AT-11 Sesi reset hanya mengizinkan ganti password
  type: http
  seq: 104
}

get {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffResetToken}}
}

tests {
  test("UM-AT-11 Sesi reset hanya mengizinkan ganti password", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().errorCode).to.equal("PASSWORD_CHANGE_REQUIRED");
  });
}
