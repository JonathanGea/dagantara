meta {
  name: UM-AT-03 Penggantian role berlaku pada token staf yang sudah ada
  type: http
  seq: 62
}

get {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

tests {
  test("UM-AT-03 Penggantian role berlaku pada token staf yang sudah ada", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().errorCode).to.equal("FORBIDDEN");
  });
}
