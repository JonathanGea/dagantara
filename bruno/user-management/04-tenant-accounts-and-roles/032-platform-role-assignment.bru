meta {
  name: UM-AT-05 Penetapan role platform ke staf A memberi 404
  type: http
  seq: 32
}

put {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users/{{staffId}}/role
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerAToken}}
}

body:json {
  {
    "roleId": "{{platformRole}}"
  }
}

tests {
  test("UM-AT-05 Penetapan role platform ke staf A memberi 404", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().errorCode).to.equal("NOT_FOUND");
  });
}
