meta {
  name: UM-AT-12 Admin tambahan tidak berubah setelah penolakan
  type: http
  seq: 98
}

get {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users/{{assistantId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAToken}}
}

tests {
  test("UM-AT-12 Admin tambahan tidak berubah setelah penolakan", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.id).to.equal(bru.getVar("assistantId"));
    expect(data.tenantId).to.equal(bru.getVar("tenantAId"));
    expect(data.roleId).to.equal(bru.getVar("adminARole"));
    expect(data.status).to.equal("ACTIVE");
  });
}
