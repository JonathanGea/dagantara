meta {
  name: UM-AT-11 Arsipkan akun staf dengan identitas dan role yang sama
  type: http
  seq: 114
}

delete {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users/{{staffId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAToken}}
}

tests {
  test("UM-AT-11 Arsipkan akun staf dengan identitas dan role yang sama", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.id).to.equal(bru.getVar("staffId"));
    expect(data.status).to.equal("ARCHIVED");
    expect(data.roleId).to.equal(bru.getVar("readerRole"));
  });
}
