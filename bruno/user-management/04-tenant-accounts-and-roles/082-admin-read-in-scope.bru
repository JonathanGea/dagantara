meta {
  name: UM-AT-12 Admin tambahan memiliki akses baca tenant yang sama
  type: http
  seq: 82
}

get {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("UM-AT-12 Admin tambahan memiliki akses baca tenant yang sama", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(res.getBody().meta.totalElements).to.equal(6);
    expect(data.every(item => item.tenantId === bru.getVar("tenantAId"))).to.equal(true);
  });
}
