meta {
  name: UM-AT-01 Login sementara calon pengelola
  type: http
  seq: 53
}

post {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{delegateUsername}}",
    "password": "{{delegateTemporary}}"
  }
}

tests {
  test("UM-AT-01 Login sementara calon pengelola", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.passwordChangeRequired).to.equal(true);
    expect(data.accessToken).to.be.a("string");
    bru.setVar("delegateSetup", data.accessToken);
  });
}
