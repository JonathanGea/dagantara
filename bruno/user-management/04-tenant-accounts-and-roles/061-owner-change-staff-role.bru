meta {
  name: UM-AT-03 Pemilik mengganti role staf
  type: http
  seq: 61
}

put {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users/{{staffId}}/role
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerAToken}}
}

body:json {
  {
    "roleId": "{{emptyRole}}"
  }
}

tests {
  test("UM-AT-03 Pemilik mengganti role staf", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.id).to.equal(bru.getVar("staffId"));
    expect(data.roleId).to.equal(bru.getVar("emptyRole"));
    expect(data.tenantId).to.equal(bru.getVar("tenantAId"));
  });
}
