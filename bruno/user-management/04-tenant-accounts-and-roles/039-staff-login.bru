meta {
  name: UM-AT-01 Staf masuk memakai password baru
  type: http
  seq: 39
}

post {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{staffUsername}}",
    "password": "{{staffPassword}}"
  }
}

tests {
  test("UM-AT-01 Staf masuk memakai password baru", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.passwordChangeRequired).to.equal(false);
    expect(data.accessToken).to.be.a("string");
    bru.setVar("staffToken", data.accessToken);
  });
}
