meta {
  name: UM-AT-03 Penolakan tidak menambah role
  type: http
  seq: 50
}

get {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/roles
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAToken}}
}

tests {
  test("UM-AT-03 Penolakan tidak menambah role", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(res.getBody().meta.totalElements).to.equal(5);
    expect(data.every(item => item.tenantId === bru.getVar("tenantAId"))).to.equal(true);
  });
}
