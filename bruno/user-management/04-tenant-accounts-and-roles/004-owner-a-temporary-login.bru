meta {
  name: UM-AT-01 Login awal pemilik A
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{ownerAUsername}}",
    "password": "{{ownerATemporary}}"
  }
}

tests {
  test("UM-AT-01 Login awal pemilik A", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.passwordChangeRequired).to.equal(true);
    expect(data.accessToken).to.be.a("string");
    bru.setVar("ownerASetup", data.accessToken);
  });
}
