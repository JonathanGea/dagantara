meta {
  name: UM-AT-04 Login pemilik A
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{ownerAUsername}}",
    "password": "{{ownerAPassword}}"
  }
}

tests {
  test("UM-AT-04 Login pemilik A", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.passwordChangeRequired).to.equal(false);
    expect(data.accessToken).to.be.a("string");
    bru.setVar("ownerAToken", data.accessToken);
  });
}
