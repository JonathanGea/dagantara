meta {
  name: UM-AT-03 Izin baca tidak memberi izin menetapkan role
  type: http
  seq: 43
}

put {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users/{{staffId}}/role
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

body:json {
  {
    "roleId": "{{emptyRole}}"
  }
}

tests {
  test("UM-AT-03 Izin baca tidak memberi izin menetapkan role", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().errorCode).to.equal("FORBIDDEN");
  });
}
