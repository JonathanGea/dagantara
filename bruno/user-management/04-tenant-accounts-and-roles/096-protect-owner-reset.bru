meta {
  name: UM-AT-12 Pemilik memakai alur pemulihan terpisah
  type: http
  seq: 96
}

post {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users/{{ownerAId}}/reset-password
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("UM-AT-12 Pemilik memakai alur pemulihan terpisah", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().errorCode).to.equal("PROTECTED_ACCOUNT");
  });
}
