meta {
  name: UM-AT-08 Izin platform bukan bagian katalog permission tenant
  type: http
  seq: 72
}

put {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/roles/{{emptyRole}}/permissions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerAToken}}
}

body:json {
  {
    "permissions": [
      "tenants.provision"
    ]
  }
}

tests {
  test("UM-AT-08 Izin platform bukan bagian katalog permission tenant", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().errorCode).to.equal("INVALID_PERMISSIONS");
  });
}
