meta {
  name: UM-AT-12 Akun Admin Tenant terlindungi dari reset-password
  type: http
  seq: 90
}

post {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users/{{assistantId}}/reset-password
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("UM-AT-12 Akun Admin Tenant terlindungi dari reset-password", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().errorCode).to.equal("PROTECTED_ACCOUNT");
  });
}
