meta {
  name: UM-AT-04 Pagination role B tidak menghitung role A
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/tenant/roles?page=0&size=1
  body: none
  auth: bearer
}

headers {
  Host: {{hostB}}
}

auth:bearer {
  token: {{ownerBToken}}
}

tests {
  test("UM-AT-04 Pagination role B tidak menghitung role A", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(res.getBody().meta.totalElements).to.equal(1);
    expect(data.every(item => item.tenantId === bru.getVar("tenantBId"))).to.equal(true);
    expect(res.getBody().meta.size).to.equal(1);
    expect(data.length).to.equal(1);
    expect(data[0].id).to.equal(bru.getVar("adminBRole"));
  });
}
