meta {
  name: UM-AT-08 Pengelola tidak dapat memberikan permission di luar kewenangannya
  type: http
  seq: 67
}

put {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/roles/{{emptyRole}}/permissions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{delegateToken}}
}

body:json {
  {
    "permissions": [
      "users.archive"
    ]
  }
}

tests {
  test("UM-AT-08 Pengelola tidak dapat memberikan permission di luar kewenangannya", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().errorCode).to.equal("FORBIDDEN");
  });
}
