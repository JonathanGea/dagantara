meta {
  name: UM-AT-12 Role pemilik terlindungi meski pemilik memintanya
  type: http
  seq: 93
}

put {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users/{{ownerAId}}/role
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerAToken}}
}

body:json {
  {
    "roleId": "{{readerRole}}"
  }
}

tests {
  test("UM-AT-12 Role pemilik terlindungi meski pemilik memintanya", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().errorCode).to.equal("PROTECTED_ACCOUNT");
  });
}
