meta {
  name: UM-AT-08 Pengelola tidak dapat menetapkan role di luar kewenangannya
  type: http
  seq: 69
}

put {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users/{{assistantId}}/role
  body: json
  auth: bearer
}

auth:bearer {
  token: {{delegateToken}}
}

body:json {
  {
    "roleId": "{{upperRole}}"
  }
}

tests {
  test("UM-AT-08 Pengelola tidak dapat menetapkan role di luar kewenangannya", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().errorCode).to.equal("FORBIDDEN");
  });
}
