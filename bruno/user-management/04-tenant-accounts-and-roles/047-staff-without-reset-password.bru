meta {
  name: UM-AT-11 Siklus akun memerlukan izin tindakan reset-password
  type: http
  seq: 47
}

post {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users/{{staffId}}/reset-password
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

tests {
  test("UM-AT-11 Siklus akun memerlukan izin tindakan reset-password", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().errorCode).to.equal("FORBIDDEN");
  });
}
