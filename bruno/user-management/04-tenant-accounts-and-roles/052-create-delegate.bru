meta {
  name: UM-AT-01 Buat akun calon pengelola staf
  type: http
  seq: 52
}

post {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerAToken}}
}

body:json {
  {
    "username": "{{delegateUsername}}",
    "roleId": "{{delegateRole}}",
    "tenantId": "{{tenantBId}}"
  }
}

tests {
  test("UM-AT-01 Buat akun calon pengelola staf", function () {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody().data;
    expect(res.getHeader("cache-control")).to.include("no-store");
    expect(data.account.id).to.match(/^[0-9a-f-]{36}$/);
    expect(data.account.tenantId).to.equal(bru.getVar("tenantAId"));
    expect(data.account.username).to.equal(bru.getVar("delegateUsername"));
    expect(data.account.roleId).to.equal(bru.getVar("delegateRole"));
    expect(data.account.status).to.equal("ACTIVE");
    expect(data.account.owner).to.equal(false);
    expect(data.temporaryPassword).to.match(/^[A-Za-z0-9_-]{32}$/);
    bru.setVar("delegateId", data.account.id);
    bru.setVar("delegateTemporary", data.temporaryPassword);
  });
}
