meta {
  name: UM-AT-12 Pemilik terlindungi dari arsip
  type: http
  seq: 95
}

delete {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/users/{{ownerAId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("UM-AT-12 Pemilik terlindungi dari arsip", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().errorCode).to.equal("PROTECTED_ACCOUNT");
  });
}
