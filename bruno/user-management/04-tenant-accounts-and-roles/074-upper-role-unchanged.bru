meta {
  name: UM-AT-08 Permission role lebih tinggi tetap utuh
  type: http
  seq: 74
}

get {
  url: {{baseUrl}}/um04-a-{{suffix}}/api/v1/tenant/roles/{{upperRole}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAToken}}
}

tests {
  test("UM-AT-08 Permission role lebih tinggi tetap utuh", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.id).to.equal(bru.getVar("upperRole"));
    expect(data.permissions).to.deep.equal(["users.archive"]);
  });
}
