meta {
  name: UM-AT-06 Validasi kredensial wajib
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {}
}

tests {
  test("Username and password are required", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().errorCode).to.equal("VALIDATION_ERROR");
    const fields = res.getBody().violations.map(violation => violation.field);
    expect(fields).to.have.members(["username", "password"]);
  });
}
