meta {
  name: UM-AT-06 Login Admin Platform pertama
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

script:pre-request {
  const username = bru.getProcessEnv("DAGANTARA_TEST_ADMIN_USERNAME");
  const password = bru.getProcessEnv("DAGANTARA_TEST_ADMIN_PASSWORD");
  if (!username || !password) {
    throw new Error("Configure the isolated platform admin fixture before running UM-AT-06");
  }
  req.setBody({ username, password });
}

tests {
  test("Persisted platform account receives a bearer token", function () {
    const data = res.getBody().data;
    expect(res.getStatus()).to.equal(200);
    expect(data.tokenType).to.equal("Bearer");
    expect(data.accessToken).to.match(/^[^.]+\.[^.]+\.[^.]+$/);
    expect(Date.parse(data.expiresAt)).to.be.greaterThan(Date.now());
  });
}
