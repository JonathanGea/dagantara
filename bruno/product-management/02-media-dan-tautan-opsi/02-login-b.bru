meta {
  name: Fixture pengelola tenant B
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/pm02-b/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {}
}

script:pre-request {
  const password = bru.getProcessEnv("PRODUCT02_FIXTURE_PASSWORD");
  if (!password) throw new Error("Set PRODUCT02_FIXTURE_PASSWORD");
  req.setBody({ username: "pm02-manager", password });
}

tests {
  test("Fixture pengelola tenant B", function () {
    expect(res.getStatus()).to.equal(200);
    const result = res.getBody().data;
    expect(result.passwordChangeRequired).to.equal(false);
    expect(result.accessToken).to.be.a("string").and.not.be.empty;
    bru.setVar("managerB", result.accessToken);
  });
}
