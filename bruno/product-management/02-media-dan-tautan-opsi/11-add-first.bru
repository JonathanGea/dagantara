meta {
  name: PM-AT-03 Tambah foto HTTPS tanpa tautan
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/pm02-a/api/v1/catalog/products/{{productA}}/media
  body: json
  auth: bearer
}

auth:bearer {
  token: {{managerA}}
}

body:json {
  {
    "url": "https://example.test/photo-a.jpg?size=full"
  }
}

tests {
  test("PM-AT-03 Tambah foto HTTPS tanpa tautan", function () {
    expect(res.getStatus()).to.equal(201);
    const photo = res.getBody().data;
    expect(photo.id).to.match(/^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$/);
    expect(photo.url).to.equal("https://example.test/photo-a.jpg?size=full");
    expect(photo.optionValueIds).to.deep.equal([]);
    bru.setVar("mediaA", photo.id);
  });
}
