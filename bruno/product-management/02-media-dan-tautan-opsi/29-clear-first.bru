meta {
  name: PM-AT-04 Daftar kosong melepas tautan foto pertama
  type: http
  seq: 29
}

put {
  url: {{baseUrl}}/pm02-a/api/v1/catalog/products/{{productA}}/media/{{mediaA}}/option-values
  body: json
  auth: bearer
}

auth:bearer {
  token: {{managerA}}
}

body:json {
  {
    "optionValueIds": []
  }
}

tests {
  test("PM-AT-04 Daftar kosong melepas tautan foto pertama", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.deep.equal({ id: bru.getVar("mediaA"), url: "https://example.test/photo-a.jpg?size=full", optionValueIds: [].sort() });
  });
}
