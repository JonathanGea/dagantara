meta {
  name: PM-AT-01 Pembaca tidak bisa mengganti tautan
  type: http
  seq: 25
}

put {
  url: {{baseUrl}}/pm02-a/api/v1/catalog/products/{{productA}}/media/{{mediaA}}/option-values
  body: json
  auth: bearer
}

auth:bearer {
  token: {{reader}}
}

body:json {
  {
    "optionValueIds": []
  }
}

tests {
  test("PM-AT-01 Pembaca tidak bisa mengganti tautan", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getHeader("content-type")).to.include("application/problem+json");
    expect(res.getBody().errorCode).to.equal("FORBIDDEN");
  });
}
