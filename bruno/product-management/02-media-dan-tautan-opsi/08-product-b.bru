meta {
  name: Fixture Produk tenant B
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/pm02-b/api/v1/catalog/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{managerB}}
}

body:json {
  {
    "name": "Produk tenant B",
    "categoryIds": [
      "{{categoryB}}"
    ],
    "primaryCategoryId": "{{categoryB}}",
    "options": [
      {
        "name": "Warna",
        "values": [
          {
            "label": "Hitam"
          },
          {
            "label": "Putih"
          }
        ]
      }
    ]
  }
}

tests {
  test("Fixture Produk tenant B", function () {
    expect(res.getStatus()).to.equal(201);
    const product = res.getBody().data;
    expect(product.id).to.match(/^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$/);
    expect(product.categoryIds).to.deep.equal([bru.getVar("categoryB")]);
    expect(product.media).to.deep.equal([]);
    expect(product.options[0].values.map(value => value.label)).to.have.members(["Hitam", "Putih"]);
    bru.setVar("productB", product.id);
    bru.setVar("productBBlack", product.options[0].values.find(value => value.label === "Hitam").id);
    bru.setVar("productBWhite", product.options[0].values.find(value => value.label === "Putih").id);
  });
}
