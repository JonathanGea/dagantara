meta {
  name: Fixture kategori tenant B
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/pm02-b/api/v1/catalog/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{managerB}}
}

body:json {
  {}
}

script:pre-request {
  const name = "Media fixture " + Date.now() + "-" + Math.random().toString(36).slice(2);
  bru.setVar("categoryBName", name);
  req.setBody({ name });
}

tests {
  test("Fixture kategori tenant B", function () {
    expect(res.getStatus()).to.equal(201);
    const category = res.getBody().data;
    expect(category.id).to.match(/^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$/);
    expect(category.name).to.equal(bru.getVar("categoryBName"));
    bru.setVar("categoryB", category.id);
  });
}
