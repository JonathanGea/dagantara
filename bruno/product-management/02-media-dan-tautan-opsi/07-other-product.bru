meta {
  name: Fixture Produk kedua A
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/pm02-a/api/v1/catalog/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{managerA}}
}

body:json {
  {
    "name": "Produk kedua A",
    "categoryIds": [
      "{{categoryA}}"
    ],
    "primaryCategoryId": "{{categoryA}}",
    "options": [
      {
        "name": "Warna",
        "values": [
          {
            "label": "Hitam"
          },
          {
            "label": "Putih"
          }
        ]
      }
    ]
  }
}

tests {
  test("Fixture Produk kedua A", function () {
    expect(res.getStatus()).to.equal(201);
    const product = res.getBody().data;
    expect(product.id).to.match(/^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$/);
    expect(product.categoryIds).to.deep.equal([bru.getVar("categoryA")]);
    expect(product.media).to.deep.equal([]);
    expect(product.options[0].values.map(value => value.label)).to.have.members(["Hitam", "Putih"]);
    bru.setVar("otherProduct", product.id);
    bru.setVar("otherProductBlack", product.options[0].values.find(value => value.label === "Hitam").id);
    bru.setVar("otherProductWhite", product.options[0].values.find(value => value.label === "Putih").id);
  });
}
