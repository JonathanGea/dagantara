meta {
  name: PM-AT-09 Pembaca masuk ke URL tenant A
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/{{shopA}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "catalog-reader",
    "password": "{{newPassword}}"
  }
}

tests {
  test("PM-AT-09 Pembaca masuk ke URL tenant A", function () {
    expect(res.getStatus()).to.equal(200);
    const result = res.getBody().data;
    expect(result.passwordChangeRequired).to.equal(false);
    expect(result.accessToken).to.be.a("string");
    bru.setVar("readerToken", result.accessToken);
  });
}
