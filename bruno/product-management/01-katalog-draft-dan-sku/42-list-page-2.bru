meta {
  name: PM-AT-01 Halaman kedua A stabil dan tidak memuat katalog B
  type: http
  seq: 42
}

get {
  url: {{baseUrl}}/{{shopA}}/api/v1/catalog/products?page=1&size=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{readerToken}}
}

tests {
  test("PM-AT-01 Halaman kedua A stabil dan tidak memuat katalog B", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.meta).to.include({ page: 1, size: 1, totalElements: 2, last: true });
    expect(body.data.map(item => item.id)).to.deep.equal([bru.getVar("productA")]);
  });
}
