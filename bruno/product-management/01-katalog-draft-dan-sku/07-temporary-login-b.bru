meta {
  name: Fixture admin B masuk dengan password sementara
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/{{shopB}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{ownerB}}",
    "password": "{{tempB}}"
  }
}

tests {
  test("Fixture admin B masuk dengan password sementara", function () {
    expect(res.getStatus()).to.equal(200);
    const result = res.getBody().data;
    expect(result.passwordChangeRequired).to.equal(true);
    expect(result.accessToken).to.be.a("string");
    bru.setVar("setupB", result.accessToken);
  });
}
