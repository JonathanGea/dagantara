meta {
  name: PM-AT-02 Pagination kategori hanya tenant A
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/{{shopA}}/api/v1/catalog/categories?page=0&size=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{readerToken}}
}

tests {
  test("PM-AT-02 Pagination kategori hanya tenant A", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.meta).to.include({ page: 0, size: 1, totalElements: 2, totalPages: 2 });
    expect(body.data.map(item => item.id)).to.deep.equal([bru.getVar("a1")]);
  });
}
