meta {
  name: PM-AT-02 Tolak primary di luar daftar
  type: http
  seq: 23
}

put {
  url: {{baseUrl}}/{{shopA}}/api/v1/catalog/products/{{productA}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminA}}
}

body:json {
  {
    "categoryIds": [
      "{{a1}}"
    ],
    "primaryCategoryId": "{{a2}}"
  }
}

tests {
  test("PM-AT-02 Tolak primary di luar daftar", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("content-type")).to.include("application/problem+json");
    expect(res.getBody().status).to.equal(400);
    expect(res.getBody().errorCode).to.equal("INVALID_CATEGORIES");
  });
}
