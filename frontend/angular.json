{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "apps",
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "projects": {
    "platform-admin": {
      "projectType": "application",
      "root": "apps/platform-admin",
      "sourceRoot": "apps/platform-admin/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/platform-admin",
            "index": "apps/platform-admin/src/index.html",
            "browser": "apps/platform-admin/src/main.ts",
            "tsConfig": "apps/platform-admin/tsconfig.app.json",
            "styles": [
              "apps/platform-admin/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4200,
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "platform-admin:build:production"
            },
            "development": {
              "buildTarget": "platform-admin:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "tenant-admin": {
      "projectType": "application",
      "root": "apps/tenant-admin",
      "sourceRoot": "apps/tenant-admin/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/tenant-admin",
            "index": "apps/tenant-admin/src/index.html",
            "browser": "apps/tenant-admin/src/main.ts",
            "tsConfig": "apps/tenant-admin/tsconfig.app.json",
            "styles": [
              "apps/tenant-admin/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4201,
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "tenant-admin:build:production"
            },
            "development": {
              "buildTarget": "tenant-admin:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "storefront": {
      "projectType": "application",
      "root": "apps/storefront",
      "sourceRoot": "apps/storefront/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/storefront",
            "index": "apps/storefront/src/index.html",
            "browser": "apps/storefront/src/main.ts",
            "tsConfig": "apps/storefront/tsconfig.app.json",
            "styles": [
              "apps/storefront/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4202,
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "storefront:build:production"
            },
            "development": {
              "buildTarget": "storefront:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
