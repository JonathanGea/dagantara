# Copy to .env for local development. Never commit .env.
SPRING_PROFILES_ACTIVE=dev
PORT=8080
# Uncomment to override the database URL and user in application-dev.yml.
# DB_URL=jdbc:postgresql://localhost:5432/dagantara
# DB_USERNAME=postgres
DB_PASSWORD=
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4300

# REQUIRED: random base64 secret containing at least 32 bytes (openssl rand -base64 48)
APP_JWT_SECRET_BASE64=
APP_JWT_ISSUER=dagantara-backend
APP_JWT_AUDIENCE=dagantara-api
APP_JWT_TTL=PT30M

# Optional first Platform Admin setup. Remove both settings after successful setup.
# Generate a BCrypt hash with "htpasswd -nBC 12 bootstrap" and copy the hash portion.
APP_BOOTSTRAP_USERNAME=
APP_BOOTSTRAP_PASSWORD_HASH=
